# -*- mode: gitignore; -*-

.DS_Store
.idea
*.log
tmp/

# Emacs backup files
*.org~

# Emacs auto-save (#file#) and lock (.#file) files
\#*#
.#*
# DOrg's local saved-file gates and fixed reclaim tombstones
.*.dorg-write.lock*

# Dolt local database
.dolt/

# Byte-compiled Elisp
*.elc
*-autoloads.el

# Explicit marker for a checkout that supplies an active installed runtime.
# Per-worktree and intentionally never propagated through Git.
.installed-root

# Flycheck
/flycheck_*

# Project metadata
.claude

# Package cache
.packages

# Development tracking (local-only)
drafts/

# Conflict fixture: generated artifacts (rebuilt by generate.el on demand)
tools/conflict-fixture/db/
tools/conflict-fixture/conflicts.org
tools/conflict-fixture/remote.org

# Tools: Issue tracking and agents
.beads/
.embead/
.dorg/
.meld/

# tracker state
.claude/settings.local.json

# local data
data/
.codex/
