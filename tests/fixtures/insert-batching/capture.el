;;; ─── Scenarios ─────────────────────────────────────────────────────────

(defun dorg-ib--install-bm25 (dolt-dir)
  "Install the BM25 extension in DOLT-DIR and commit."
  (dorg-bm25-register-extension)
  (dorg-migrate-schema dolt-dir)
  (dorg-commit dolt-dir "install bm25 extension"))

(defun dorg-ib--id-by-title (dolt-dir title)
  "Return the id of the heading titled TITLE in DOLT-DIR."
  (alist-get 'id (car (dorg-sql dolt-dir
                                (format "SELECT id FROM headings WHERE title = %s"
                                        (dorg-sql-quote title))))))

(defun dorg-ib--source (dolt-dir root-id)
  "Return the mutation source for ROOT-ID in DOLT-DIR."
  (dorg-mutate--resolve-source (list :dolt-dir dolt-dir :root-id root-id)))

(defun dorg-ib--plan-surface (plan)
  "Return the comparable dry-run fields of mutation PLAN.
The private execution attempt holds closures and is dropped; core db-ops
reduce to their operation keyword and SQL; extension SQL is kept whole."
  (list :db-ops
        (mapcar (lambda (op)
                  (if (plist-get op :ext-sql)
                      (list :ext-sql (plist-get op :ext-sql))
                    (list :op (car op) :sql (plist-get op :sql))))
                (plist-get plan :db-ops))
        :extensions (plist-get plan :extensions)
        :ext-dirty (plist-get plan :ext-dirty)
        :created (plist-get plan :created)
        :changed (plist-get plan :changed)
        :deleted (plist-get plan :deleted)
        :moved (plist-get plan :moved)
        :invalidation (plist-get plan :invalidation)))

(defun dorg-ib-mutation (generator dolt-dir root-id patches)
  "Dry-run then apply PATCHES on ROOT-ID in DOLT-DIR, observed.
Ids come from GENERATOR (see `dorg-ib-with-ids')."
  (dorg-ib-with-ids generator log
    (let ((plan (dorg-ib-call-observed
                 (lambda ()
                   (dorg-ib--plan-surface
                    (dorg-mutate--plan-patches
                     (dorg-ib--source dolt-dir root-id) patches nil)))))
          (apply (dorg-ib-call-observed
                  (lambda ()
                    (let ((result (dorg-mutate--apply-patches
                                   (dorg-ib--source dolt-dir root-id) patches nil)))
                      (list :extensions (plist-get result :extensions)
                            :created (plist-get result :created)
                            :changed (plist-get result :changed)
                            :deleted (plist-get result :deleted)
                            :moved (plist-get result :moved)))))))
      (list :plan plan :apply apply :id-calls (reverse (car log))
            :dump (dorg-ib-dump dolt-dir)))))

(defun dorg-ib-scenarios (dolt-dir dir)
  "Run every oracle scenario in DOLT-DIR with sources in DIR.
Scenarios run in order on one store and draw ids from ONE deterministic
generator, so no two scenarios issue the same id: bootstrap, replace, an ordinary edit
\(title and drawer property), an in-root move before a sibling, a
cross-root move into a second root, and a BM25 rebuild repair of a lost
derived row."
  (let ((dorg--extensions nil)
        (ids (dorg-ib-id-generator))
        ;; Both spellings of each temporary root: macOS reports /var paths
        ;; under their /private/var truename.
        (roots (list (cons (file-name-as-directory (file-truename dir)) "dir")
                     (cons (file-name-as-directory dir) "dir")
                     (cons (file-name-as-directory (file-truename dolt-dir)) "store")
                     (cons (file-name-as-directory dolt-dir) "store")
                     (cons (directory-file-name (file-truename dolt-dir)) "store")
                     (cons (directory-file-name dolt-dir) "store")))
        out)
    (dorg-ib--install-bm25 dolt-dir)
    (let* ((boot (dorg-ib-import ids dolt-dir dir "corpus" dorg-ib-corpus-bootstrap
                                 'bootstrap))
           (root-id (plist-get (plist-get boot :value) :root-id)))
      (push (cons :bootstrap (append boot (list :dump (dorg-ib-dump dolt-dir))))
            out)
      (let ((replace (dorg-ib-import ids dolt-dir dir "corpus" dorg-ib-corpus-replace
                                     'replace (dorg-head-commit dolt-dir))))
        (push (cons :replace (append replace (list :dump (dorg-ib-dump dolt-dir))))
              out))
      (let ((alpha (dorg-ib--id-by-title dolt-dir "Alpha renamed")))
        (push (cons :mutate-ordinary
                    (dorg-ib-mutation
                     ids dolt-dir root-id
                     (list (list :op 'update :target (list :heading :id alpha)
                                 :fields (list :title "Alpha edited 'e' \U0001F600"))
                           (list :op 'put
                                 :target (list :property :host (list :heading :id alpha)
                                               :name "CUSTOM")
                                 :value "009; 'p'"))))
              out))
      (let ((delta (dorg-ib--id-by-title dolt-dir "Delta new")))
        (push (cons :mutate-move
                    (dorg-ib-mutation
                     ids dolt-dir root-id
                     (list (list :op 'move :target (list :subtree :id delta)
                                 :to (list :under (list :heading :id root-id)
                                           :before (list :heading :id 9007199254741001))))))
              out))
      (let* ((second (dorg-ib-import ids dolt-dir dir "second" dorg-ib-corpus-second
                                     'bootstrap))
             (second-root (plist-get (plist-get second :value) :root-id)))
        (push (cons :second-bootstrap
                    (append second (list :dump (dorg-ib-dump dolt-dir))))
              out)
        (push (cons :mutate-cross-root
                    (dorg-ib-mutation
                     ids dolt-dir root-id
                     (list (list :op 'move :target (list :subtree :id 41)
                                 :to (list :under (list :heading :id 9000000000000000013))
                                 :to-source (dorg-ib--source dolt-dir second-root)))))
              out)
        ;; The rebuild runs on the second root: it has no preamble document,
        ;; so a rebuild there is clean apart from the one row removed here.
        (dorg-sql dolt-dir
                  (format (concat "DELETE FROM dorg_bm25_documents "
                                  "WHERE root_id = %d AND heading_id = %d")
                          second-root 53))
        (dorg-commit dolt-dir "lose one derived row")
        (push (cons :rebuild
                    (append
                     (dorg-ib-call-observed
                      (lambda ()
                        (let ((receipt (dorg-ext-rebuild-index
                                        'bm25 second-root :dolt-dir dolt-dir
                                        :revision (dorg-head-commit dolt-dir)
                                        :identity 'dorg :mode 'repair)))
                          (list :drift (plist-get receipt :drift)))))
                     (list :dump (dorg-ib-dump dolt-dir))))
              out)))
    (dorg-ib-normalize (nreverse out) roots)))

;;; ─── One-shot capture ──────────────────────────────────────────────────

(defun dorg-ib--file-sha256 (file)
  "Return the sha256 of FILE's bytes."
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally file)
    (secure-hash 'sha256 (current-buffer))))

(defun dorg-ib-header ()
  "Return the provenance header for a capture run from the current checkout."
  (let ((default-directory (expand-file-name "../../../" dorg-ib-fixture-dir)))
    (list :base (string-trim (shell-command-to-string "git rev-parse HEAD"))
          :base-tree (string-trim
                      (shell-command-to-string "git rev-parse HEAD^{tree}"))
          ;; The product revision the oracle stands for, and every path by
          ;; which the capturing checkout differs from it: only this
          ;; fixture directory may appear.
          :product-base dorg-ib-product-base
          :diff-from-product-base
          (split-string
           (shell-command-to-string
            (format "git diff --name-only %s HEAD" dorg-ib-product-base))
           "\n" t)
          :uncommitted (split-string
                        (shell-command-to-string
                         "git status --porcelain --untracked-files=all")
                        "\n" t)
          :script-sha256 (dorg-ib--file-sha256
                          (expand-file-name "capture.el" dorg-ib-fixture-dir))
          :corpus-sha256
          (mapcar (lambda (text)
                    (secure-hash 'sha256 (encode-coding-string text 'utf-8)))
                  (list dorg-ib-corpus-bootstrap dorg-ib-corpus-replace
                        dorg-ib-corpus-second))
          :emacs emacs-version
          :dolt (string-trim (shell-command-to-string "dolt version")))))

(defun dorg-ib-read-golden ()
  "Return the frozen base oracle."
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix))
      (insert-file-contents dorg-ib-golden-file))
    (goto-char (point-min))
    (read (current-buffer))))

(when (getenv "DORG_INSERT_BATCHING_CAPTURE")
  (ert-deftest dorg-capture-insert-batching-base ()
    "Write the base oracle to $DORG_INSERT_BATCHING_CAPTURE.  Not a test."
    (skip-unless (and dorg-test--dolt-available dorg-test--server-port))
    (let ((out (getenv "DORG_INSERT_BATCHING_CAPTURE"))
          (dir (make-temp-file "dorg-ib-capture-" t)))
      (unwind-protect
          (dorg-test--with-temp-db dolt-dir
            (let ((golden
                   (list :header (dorg-ib-header)
                         :scalar (dorg-ib-normalize (dorg-ib-scalar-surface) nil)
                         :effects (dorg-ib-effect-surface dorg-ib-effect-samples)
                         :scenarios (dorg-ib-scenarios dolt-dir dir))))
              (let ((coding-system-for-write 'utf-8-unix)
                    (print-length nil) (print-level nil)
                    (print-escape-newlines t) (print-escape-nonascii nil)
                    (print-circle nil))
                (with-temp-file out
                  (insert ";; -*- coding: utf-8; mode: lisp-data -*-\n")
                  (insert ";; Frozen base oracle for multi-row insert lowering.  Generated by\n")
                  (insert ";; capture.el at the :base revision in the header; never edit by hand.\n")
                  (prin1 golden (current-buffer))
                  (insert "\n")))))
        (delete-directory dir t)))))

(provide 'dorg-insert-batching-capture)
