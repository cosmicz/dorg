;;; ─── Deterministic, nonmonotonic BIGINT ids ────────────────────────────

(defun dorg-ib-id-generator ()
  "Return a deterministic nonmonotonic BIGINT id generator.
Odd calls count down from 2^62 and even calls count up from 2^53 + 1, so ids
are BIGINT, above the float-exact range and out of order."
  (let ((i 0))
    (lambda ()
      (cl-incf i)
      (if (cl-oddp i)
          (- (ash 1 62) (* i 7919))
        (+ (ash 1 53) 1 (* i 104729))))))

(defmacro dorg-ib-with-ids (generator log-var &rest body)
  "Run BODY with `dorg-id-generate' drawing from GENERATOR.
GENERATOR is a `dorg-ib-id-generator' closure, or nil for a fresh one.
LOG-VAR is bound to a cell whose car accumulates, in reverse call order, only
the ids issued during BODY."
  (declare (indent 2))
  (let ((gen (make-symbol "gen")))
    `(let* ((,gen (or ,generator (dorg-ib-id-generator)))
            (,log-var (list nil)))
       (cl-letf (((symbol-function 'dorg-id-generate)
                  (lambda ()
                    (let ((id (funcall ,gen)))
                      (push id (car ,log-var))
                      id))))
         ,@body))))

;;; ─── Normalization ─────────────────────────────────────────────────────

(defun dorg-ib--hex (bytes)
  "Return BYTES (a unibyte string) as a lowercase hex string."
  (mapconcat (lambda (b) (format "%02x" b)) bytes ""))

(defun dorg-ib--binary-p (value)
  "Non-nil when VALUE is a unibyte string carrying a non-ASCII byte."
  (and (stringp value)
       (not (multibyte-string-p value))
       (string-match-p "[\200-\377]" value)))

(defun dorg-ib-normalize (data roots)
  "Return DATA with commit hashes and paths under ROOTS normalized.
ROOTS is an alist of (PREFIX . NAME): a string starting with PREFIX becomes
\(:path NAME REST).  A 32-character Dolt hash becomes `:commit'.  A
`dorg_files' upsert statement becomes `:dorg-files-row'.  Unibyte binary
strings become (:hex HEX).  Records and hash tables are rejected: callers
reduce them first, so the golden data stays plain and readable."
  (cond
   ((stringp data)
    (cond
     ((string-match-p "\\`[0-9a-v]\\{32\\}\\'" data) :commit)
     ((string-prefix-p "INSERT INTO dorg_files " data) :dorg-files-row)
     ((dorg-ib--binary-p data) (list :hex (dorg-ib--hex data)))
     (t (or (cl-some (lambda (root)
                       (when (string-prefix-p (car root) data)
                         (list :path (cdr root)
                               (substring data (length (car root))))))
                     roots)
            data))))
   ((consp data)
    (cons (dorg-ib-normalize (car data) roots)
          (dorg-ib-normalize (cdr data) roots)))
   ((or (recordp data) (hash-table-p data) (vectorp data)
        (and (functionp data) (not (symbolp data))))
    (error "dorg-ib-normalize: unreduced value %S" (type-of data)))
   (t data)))

