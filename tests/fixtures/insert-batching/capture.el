(defconst dorg-ib-dump-tables
  '(("headings" . "id")
    ("heading_tags" . "heading_id, ordinal")
    ("heading_items" . "id")
    ("text_items" . "item_id")
    ("keyword_items" . "item_id")
    ("planning_items" . "item_id")
    ("drawer_items" . "item_id")
    ("property_entries" . "id")
    ("drawer_lines" . "id")
    ("dorg_files" . "root_id")
    ("dorg_meta" . "`key`")
    ("dorg_bm25_documents" . "root_id, heading_id, profile")
    ("dorg_bm25_postings" . "root_id, heading_id, profile, field_name, term")
    ("dorg_bm25_terms" . "root_id, profile, field_name, term")
    ("dorg_bm25_manifest" . "root_id, profile"))
  "Every core and BM25 table the oracle compares, with its full order key.
The mutation log is excluded: it records wall-clock time and generation ids.")

(defun dorg-ib-dump (dolt-dir &optional extra-tables)
  "Return every row of the oracle tables in DOLT-DIR, fully ordered.
EXTRA-TABLES is an alist of further (TABLE . ORDER-KEY) to include.  The
`dorg_files' relative path is store-local and is reduced to its file name."
  (mapcar
   (lambda (spec)
     (cons (car spec)
           (mapcar
            (lambda (row)
              (mapcar (lambda (cell)
                        (if (and (equal (car spec) "dorg_files")
                                 (eq (car cell) 'relative_path))
                            (cons (car cell) (file-name-nondirectory (cdr cell)))
                          cell))
                      row))
            (dorg-sql dolt-dir (format "SELECT * FROM %s ORDER BY %s"
                                       (car spec) (cdr spec))))))
   (append dorg-ib-dump-tables extra-tables)))

(defun dorg-ib-bindings (headings)
  "Return the persisted identity bindings carried by parsed HEADINGS.
Each entry is (HEADING-ID HEADING-SORT-KEY ITEMS) where ITEMS lists each
item's (ITEM-ID . SORT-KEY), in item order."
  (mapcar (lambda (heading)
            (list (dorg-heading-id heading)
                  (dorg-heading-sort-key heading)
                  (mapcar (lambda (item)
                            (cons (dorg-item-id item) (dorg-item-sort-key item)))
                          (dorg-heading-items heading))))
          headings))

(defun dorg-ib-call-observed (thunk)
  "Call THUNK and return (:value V :commits C :lease-batches L :projections P).
Every `dorg-transaction-commit' statement list, every lease batch statement
list and every projection result (:effects and :extensions) is recorded in
call order.  The calls themselves run unchanged."
  (let ((commit-fn (symbol-function 'dorg-transaction-commit))
        (lease-fn (symbol-function 'dorg-sql--lease-batch))
        (projection-fn (symbol-function 'dorg-ext-collect-index-projection))
        commits batches projections value)
    (cl-letf (((symbol-function 'dorg-transaction-commit)
               (lambda (dir base statements &rest rest)
                 (push (copy-sequence statements) commits)
                 (apply commit-fn dir base statements rest)))
              ((symbol-function 'dorg-sql--lease-batch)
               (lambda (lease statements &rest rest)
                 (push (copy-sequence statements) batches)
                 (apply lease-fn lease statements rest)))
              ((symbol-function 'dorg-ext-collect-index-projection)
               (lambda (&rest args)
                 (let ((result (apply projection-fn args)))
                   (push (list :effects (copy-tree (plist-get result :effects))
                               :extensions (copy-tree (plist-get result :extensions)))
                         projections)
                   result))))
      (setq value (funcall thunk)))
    (list :value value
          :commits (nreverse commits)
          :lease-batches (nreverse batches)
          :projections (nreverse projections))))

(defun dorg-ib-import (generator dolt-dir dir name text mode &optional base)
  "Import TEXT as DIR/NAME.org into DOLT-DIR in MODE, observed.
Ids come from GENERATOR (see `dorg-ib-with-ids').  The source file is DIR/NAME-MODE-source.org.  Returns the observation plist
plus :core-sql, :bindings and :id-calls."
  (let ((source (expand-file-name (format "%s-%s-source.org" name mode) dir))
        (target (expand-file-name (format "%s.org" name) dir))
        (core-fn (symbol-function 'dorg-import--core-sql))
        core-sql bindings)
    (let ((coding-system-for-write 'utf-8-unix))
      (with-temp-file source (insert text)))
    (dorg-ib-with-ids generator log
      (cl-letf (((symbol-function 'dorg-import--core-sql)
                 (lambda (dolt parsed &rest rest)
                   (let ((sql (apply core-fn dolt parsed rest)))
                     (setq core-sql (copy-sequence sql)
                           bindings (dorg-ib-bindings
                                     (dorg-parse-result-headings parsed)))
                     sql))))
        (append
         (dorg-ib-call-observed
          (lambda ()
            (apply #'dorg-import-document source :dolt-dir dolt-dir
                   :target-file target :mode mode
                   (and base (list :base base)))))
         (list :core-sql core-sql
               :bindings bindings
               :id-calls (reverse (car log))))))))

;;; ─── Scalar generator surface ──────────────────────────────────────────

(defun dorg-ib-parse (text)
  "Return parsed TEXT with ids assigned by a fresh deterministic generator."
  (dorg-ib-with-ids nil _log
    (with-temp-buffer
      (insert text)
      (org-mode)
      (let ((parsed (dorg-parse-buffer)))
        (dorg-parse-assign-ids parsed)
        parsed))))

(defun dorg-ib-scalar-surface ()
  "Return every scalar generator string the corpus reaches, labelled.
Each generator runs on fresh parse state with its own deterministic item
generator, so the inputs are reproducible by any later caller."
  (let* ((parsed (dorg-ib-parse dorg-ib-corpus-bootstrap))
         (root-id (dorg-parse-result-root-id parsed))
         (headings (dorg-parse-result-headings parsed))
         (fresh #'dorg-ib-id-generator)
         out)
    (dolist (heading headings)
      (let ((id (dorg-heading-id heading)))
        (push (list :heading-insert id
                    (dorg-sql-gen-heading-insert heading root-id))
              out)
        (push (list :tag-inserts id
                    (dorg-sql-gen-tag-inserts id (dorg-heading-tags heading)))
              out)))
    ;; Item-level scalars on a separate parse so no binding leaks between
    ;; the item, items and full forms.
    (let ((items-parsed (dorg-ib-parse dorg-ib-corpus-bootstrap)))
      (dolist (heading (dorg-parse-result-headings items-parsed))
        (push (list :heading-items-sql (dorg-heading-id heading)
                    (dorg-sql-gen-heading-items-sql heading (funcall fresh)))
              out)))
    (let ((full-parsed (dorg-ib-parse dorg-ib-corpus-bootstrap)))
      (dolist (heading (dorg-parse-result-headings full-parsed))
        (push (list :heading-full-sql (dorg-heading-id heading)
                    (dorg-sql-gen-heading-full-sql
                     heading (dorg-parse-result-root-id full-parsed)
                     (funcall fresh)))
              out)))
    (let ((item-parsed (dorg-ib-parse dorg-ib-corpus-bootstrap))
          (n 0))
      (dolist (heading (dorg-parse-result-headings item-parsed))
        (dolist (item (cl-remove-if #'dorg-item--db-local-p
                                    (dorg-heading-items heading)))
          (cl-incf n)
          (push (list :item-to-sql (dorg-heading-id heading) n
                      (dorg-item-to-sql item (+ 1000 n) (dorg-heading-id heading)
                                        (unibyte-string n #x80)))
                out)
          (when (cl-typep item 'dorg-drawer-item)
            (push (list :drawer-detail-inserts (dorg-heading-id heading) n
                        (dorg-sql-gen--drawer-detail-inserts (+ 1000 n) item))
                  out)))))
    ;; Mutation lowering stays scalar; these strings are its unchanged-surface
    ;; control.  Each old item is paired with the first replacement-corpus
    ;; item of the same class and drawer form, or with itself.
    (let* ((old-parsed (dorg-ib-parse dorg-ib-corpus-bootstrap))
           (new-items (cl-mapcan
                       (lambda (heading)
                         (cl-remove-if #'dorg-item--db-local-p
                                       (copy-sequence (dorg-heading-items heading))))
                       (dorg-parse-result-headings
                        (dorg-ib-parse dorg-ib-corpus-replace))))
           (form (lambda (item)
                   (list (eieio-object-class item)
                         (and (cl-typep item 'dorg-drawer-item)
                              (not (null (dorg-drawer-item-properties item)))))))
           (n 0))
      (dolist (heading (dorg-parse-result-headings old-parsed))
        (push (list :heading-update (dorg-heading-id heading)
                    (dorg-sql-gen-heading-update heading))
              out)
        (dolist (item (cl-remove-if #'dorg-item--db-local-p
                                    (dorg-heading-items heading)))
          (cl-incf n)
          (setf (dorg-item-id item) (+ 2000 n))
          (let ((new (or (cl-find (funcall form item) new-items
                                  :key form :test #'equal)
                         item)))
            (push (list :item-update (dorg-heading-id heading) n
                        (dorg-sql-gen-item-update item new))
                  out)
            (push (list :item-row-update n
                        (dorg-sql-gen-item-row-update
                         (+ 2000 n) (unibyte-string n #xfe) (mod n 3)))
                  out))))
      (push (list :rekey-headings
                  (dorg-sql-gen-rekey-sql
                   "headings"
                   (cl-loop for heading in (dorg-parse-result-headings old-parsed)
                            for k from 1
                            collect (cons (dorg-heading-id heading)
                                          (unibyte-string #x40 k #x80)))))
            out)
      (push (list :rekey-items
                  (dorg-sql-gen-rekey-sql
                   "heading_items"
                   (cl-loop for k from 1 to n
                            collect (cons (+ 2000 k) (unibyte-string k #xff)))))
            out))
    (nreverse out)))

